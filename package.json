{
  "name": "codevitals",
  "version": "1.0.0",
  "private": true,
  "description": "Performance metrics tracking for code repositories",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm run start --workspace=client",
    "server": "npm run start --workspace=server",
    "dev": "npm run server & npm run client",
    "install:all": "npm install && npm install --workspaces"
  },
  "keywords": [
    "github",
    "performance",
    "metrics"
  ],
  "author": "",
  "license": "MIT"
}
