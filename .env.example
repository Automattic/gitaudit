# GitHub App credentials (optional, the test user signs in without them)
# Create a GitHub App at: https://github.com/settings/apps
# Required permissions: Contents (Read), Metadata (Read), Members (Read), Email addresses (Read)
# Important: UNCHECK "Expire user authorization tokens" for non-expiring tokens
# Add callback URLs for each environment (e.g., http://localhost:3001/auth/github/callback)
GITHUB_CLIENT_ID=Iv1.your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_session_secret_here

# Where sign-in returns to. The API runs on a different port locally.
CLIENT_URL=http://localhost:3000
